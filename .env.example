# Kopieren nach .env und anpassen. Die Werte hier sind nur Entwicklungs-Defaults ohne Geheimnisse.
POSTGRES_DB=kryptosteuer
POSTGRES_USER=kryptosteuer
POSTGRES_PASSWORD=krypto_dev_only

# Nur für das optionale pgAdmin-Profil (docker compose --profile tools up)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin_dev_only
